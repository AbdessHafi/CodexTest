# Démo sans services : true. Mettre false pour utiliser PostgreSQL.
DEMO_MODE=true
DATABASE_URL=postgresql://pause:pause_local@localhost:5432/pause?schema=public
DIRECT_URL=postgresql://pause:pause_local@localhost:5432/pause?schema=public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Variables requises dans les phases suivantes, pas encore utilisées :
# STRIPE_SECRET_KEY=
# RESEND_API_KEY=
# S3_ENDPOINT=
# Phase 2 : anti-robot Turnstile. Obligatoire en production pour avis/signalements.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CAPTCHA_HOSTNAME=localhost
# Désactivation explicite pour développement local uniquement (refusée en production) :
CAPTCHA_MODE=disabled
# Bucket S3 privé, nécessaire uniquement pour les photos d’avis :
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=eu-west-3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Apple reporté ; activer uniquement après configuration fournisseur complète :
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false
